    <mxCell id="note" value="Chỉ quan tâm: Thực thể và mối quan hệ • Không quan tâm kiểu dữ liệu, cách lưu trữ • Dễ hiểu với người dùng, dùng trong giai đoạn phân tích hệ thống" style="text;html=1;strokeColor=#000000;fillColor=#f5f5f5;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="600" height="30" as="geometry"/></mxCell>

