@startuml
title Sơ đồ tuần tự - Quản lý Đơn hàng (Admin)

actor "NV Kho" as NV
participant ":B_DonHang" as B
participant ":C_OrderAdmin" as C
participant ":E_Order" as EO
participant ":E_StockLog" as ES
participant ":E_Product" as EP

NV -> B : 1: Chọn đơn hàng đã thanh toán
NV -> B : 2: Nhấn Xuất kho - Giao shipper
B -> C : 3: updateStatus(id, action=export_warehouse)
C -> EO : 4: findOrderDetails(id)
EO --> C : 5: return(details)

loop Từng sản phẩm trong đơn
    C -> ES : 6: getBatchTotals(product_id) [FIFO]
    ES --> C : 7: return(batches)
    C -> ES : 8: createExportLog(batch, qty)
    C -> EP : 9: decrementQuantity(qty)
    EP --> C : 10: return
end

C -> EO : 11: updateStatus(id, status=3)
EO --> C : 12: return
C --> NV : 13: Đã xuất kho, chuyển giao shipper
@enduml
