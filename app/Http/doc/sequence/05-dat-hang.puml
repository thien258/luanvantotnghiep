@startuml
title Sơ đồ tuần tự - Đặt hàng

actor "Khách hàng" as KH
participant ":B_DatHang" as B
participant ":C_Order" as C
participant ":E_Order" as EO
participant ":E_Cart" as EC
participant ":PayOS" as P
participant ":Mail" as M

KH -> B : 1: Chọn sản phẩm và nhấn Tiến hành đặt hàng
B -> C : 2: checkout(cart_ids)
C -> C : 3: Lưu cart_ids vào session
C --> KH : 4: Hiển thị trang thanh toán

KH -> B : 5: Nhập thông tin giao hàng
KH -> B : 6: Chọn phương thức thanh toán (COD / Chuyển khoản)
KH -> B : 7: Nhấn Đặt hàng
B -> C : 8: placeOrder(data)
C -> C : 9: Kiểm tra dữ liệu

alt [Thông tin không hợp lệ]
    C --> KH : 10: Thông báo lỗi, quay lại form

else [Thông tin hợp lệ]
    C -> EO : 11: Tạo đơn hàng
    EO --> C : 12: return(order)
    C -> EO : 13: Lưu chi tiết đơn hàng
    C -> EC : 14: Xóa sản phẩm đã đặt khỏi giỏ
    EC --> C : 15: return

    alt [Phương thức = Chuyển khoản]
        C -> P : 16: Tạo link thanh toán PayOS
        P --> C : 17: return(checkoutUrl)
        C --> KH : 18: Chuyển hướng sang trang PayOS
        KH -> P : 19: Thanh toán trên PayOS
        P --> KH : 20: Chuyển hướng về trang thành công
        P -> C : 21: Webhook xác nhận thanh toán (chạy song song)
        C -> EO : 22: Cập nhật trạng thái đơn hàng
        EO --> C : 23: return
        C -> M : 24: Gửi email xác nhận đơn hàng
        M --> KH : 25: Email xác nhận

    else [Phương thức = COD]
        C -> P : 16: Tạo link PayOS (lấy mã QR nhúng vào mail)
        P --> C : 17: return(payosUrl)
        C -> M : 18: Gửi email xác nhận đơn hàng (kèm mã QR)
        M --> KH : 19: Email xác nhận (có mã QR chuyển khoản)
        C --> KH : 20: Chuyển hướng về trang chủ

        opt [Khách quét mã QR trong email để chuyển khoản - tuỳ chọn]
            KH -> P : 21: Quét mã QR, thanh toán trên PayOS
            P -> C : 22: Webhook xác nhận (đơn COD đã chuyển khoản)
            C -> EO : 23: Cập nhật trạng thái + đổi phương thức sang Chuyển khoản
            EO --> C : 24: return
            C -> M : 25: Gửi email xác nhận đã thanh toán
            M --> KH : 26: Email xác nhận thanh toán
        end
    end
end
@enduml
