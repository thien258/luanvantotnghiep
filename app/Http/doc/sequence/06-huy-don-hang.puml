@startuml
title Sơ đồ tuần tự - Hủy Đơn hàng

actor "Khách hàng" as KH
participant ":B_LichSu" as B
participant ":C_Order" as C
participant ":E_Order" as EO
participant ":E_Cart" as EC

KH -> B : 1: Vào trang lịch sử đơn hàng
KH -> B : 2: Chọn đơn hàng cần hủy
KH -> B : 3: Nhập lý do hủy và nhấn Hủy đơn hàng
B -> C : 4: cancelOrder(id, reason)
C -> C : 5: Kiểm tra lý do hủy (bắt buộc, ít nhất 5 ký tự)

alt Lý do hủy không hợp lệ
    C --> KH : 6: Thông báo lỗi, quay lại form
else Lý do hợp lệ
    C -> EO : 6: Tìm đơn hàng (id, userId, status = 1)
    EO --> C : 7: Trả về đơn hàng

    alt Đơn hàng hợp lệ (status = 1, chưa xuất kho)
        C -> EO : 8: Đổi status = -1 (đã hủy), lưu lý do vào note
        EO --> C : 9: Trả về kết quả
       
            C -> EC : 10: Hoàn sản phẩm về giỏ hàng
            EC --> C : 11: Trả về kết quả
        
        C --> KH : 12: Hủy thành công, chuyển về lịch sử đơn hàng
    else Đơn đã xuất kho hoặc đang giao (status != 1)
        C --> KH : 13: Không thể hủy đơn hàng này
    end
end
@enduml
