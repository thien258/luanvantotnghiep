@startuml
title Sơ đồ tuần tự - Đăng ký của Khách hàng

actor "Khách hàng" as KH
participant ":B_DangKy" as B
participant ":C_DangKy" as C
participant ":E_DangKy" as E

KH -> B : 1: Truy cập trang đăng ký
B --> KH : 2: formDangKy()

KH -> B : 3: Nhập thông tin
KH -> B : 4: Nhấn nút đăng ký

B -> C : 5: create(User)

C -> E : 6: kiemTraThongTin()
E --> C : 7: return

alt Thông tin hợp lệ
    C -> E : 8: saveUser()
    E --> C : 9: return
    C --> KH : 9: Đăng ký thành công
else Thông tin không hợp lệ
    C --> KH : 10: Tài khoản đã tồn tại
end

@enduml
